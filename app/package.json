{
  "name": "worklive",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "web": "vite --host 127.0.0.1 --port 1432 --strictPort",
    "build:web": "tsc --noEmit && vite build",
    "build": "tauri build --bundles app",
    "check": "tsc --noEmit && node --check worker/main.mjs && node --test worker/*.test.mjs && node --test tests/office-crowd.test.mjs tests/hair-check.test.mjs tests/character-fit.test.mjs",
    "setup": "npm install && npm --prefix worker install"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0",
    "dompurify": "3.4.16",
    "lucide": "1.41.0",
    "marked": "18.0.14",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@types/three": "0.185.4",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
